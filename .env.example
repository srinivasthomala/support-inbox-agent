# Copy to .env for local runs. On Fly, set these with `fly secrets set`.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5

# Postgres in production (Neon), SQLite locally.
DATABASE_URL=sqlite:///./support_agent.db

# Google OAuth client (Desktop app) + refresh token from scripts/google_auth.py
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
SHEET_ID=

# Slack app: bot token (xoxb-...), signing secret, channel id (C...)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=

# Real addresses you will send test emails from, mapped onto Maya, Leo, Sam, Ana.
DEMO_CUSTOMER_EMAILS=

POLLER_ENABLED=false
